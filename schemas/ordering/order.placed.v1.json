{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wesleyplago/lagoski-contracts/schemas/ordering/order.placed.v1.json",
  "title": "lagoski.ordering.order.placed.v1",
  "description": "Carrinho virou pedido, com preço congelado por item. Inicia a saga.",
  "type": "object",
  "required": [
    "orderId",
    "customerId",
    "currency",
    "totalCents",
    "lines"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ord_[0-9A-Z]{26}$"
    },
    "customerId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^cus_"
    },
    "currency": {
      "const": "BRL"
    },
    "totalCents": {
      "type": "integer",
      "minimum": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "productName",
          "quantity",
          "unitPriceCents"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "productName": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          },
          "unitPriceCents": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
