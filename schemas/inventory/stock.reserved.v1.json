{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wesleyplago/lagoski-contracts/schemas/inventory/stock.reserved.v1.json",
  "title": "lagoski.inventory.stock.reserved.v1",
  "description": "Todas as linhas do pedido foram reservadas até expiresAt.",
  "type": "object",
  "required": [
    "orderId",
    "reservationId",
    "expiresAt",
    "lines"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ord_[0-9A-Z]{26}$"
    },
    "reservationId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^rsv_"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
