{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wesleyplago/lagoski-contracts/schemas/inventory/stock.reservation-rejected.v1.json",
  "title": "lagoski.inventory.stock.reservation-rejected.v1",
  "description": "Algum SKU não tinha saldo; nada foi reservado.",
  "type": "object",
  "required": [
    "orderId",
    "unavailable"
  ],
  "properties": {
    "orderId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ord_[0-9A-Z]{26}$"
    },
    "unavailable": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "requested",
          "available"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "requested": {
            "type": "integer",
            "minimum": 1
          },
          "available": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
