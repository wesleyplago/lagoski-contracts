{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wesleyplago/lagoski-contracts/schemas/catalog/product.published.v1.json",
  "title": "lagoski.catalog.product.published.v1",
  "description": "Produto publicado com todas as variantes (tamanho × cor) e preço de lista.",
  "type": "object",
  "required": [
    "productId",
    "slug",
    "name",
    "currency",
    "variants"
  ],
  "properties": {
    "productId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^prd_"
    },
    "slug": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "const": "BRL"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "size",
          "color",
          "priceCents"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "enum": [
              "P",
              "M",
              "G",
              "GG"
            ]
          },
          "color": {
            "type": "string",
            "minLength": 1
          },
          "priceCents": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
