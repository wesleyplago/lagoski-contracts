{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wesleyplago/lagoski-contracts/schemas/fulfillment/shipment.created.v1.json",
  "title": "lagoski.fulfillment.shipment.created.v1",
  "description": "Remessa criada para um pedido confirmado.",
  "type": "object",
  "required": [
    "shipmentId",
    "orderId",
    "customerId",
    "lines"
  ],
  "properties": {
    "shipmentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^shp_"
    },
    "orderId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ord_[0-9A-Z]{26}$"
    },
    "customerId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^cus_"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sku",
          "quantity"
        ],
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
