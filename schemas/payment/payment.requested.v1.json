{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wesleyplago/lagoski-contracts/schemas/payment/payment.requested.v1.json",
  "title": "lagoski.payment.payment.requested.v1",
  "description": "Checkout aberto no gateway; o cliente paga em checkoutUrl até expiresAt.",
  "type": "object",
  "required": [
    "paymentId",
    "orderId",
    "amountCents",
    "currency",
    "checkoutUrl",
    "expiresAt"
  ],
  "properties": {
    "paymentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^pay_"
    },
    "orderId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ord_[0-9A-Z]{26}$"
    },
    "amountCents": {
      "type": "integer",
      "minimum": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[a-z]{3}$"
    },
    "checkoutUrl": {
      "type": "string",
      "format": "uri"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
