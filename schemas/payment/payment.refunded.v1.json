{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wesleyplago/lagoski-contracts/schemas/payment/payment.refunded.v1.json",
  "title": "lagoski.payment.payment.refunded.v1",
  "description": "Pagamento estornado por inteiro.",
  "type": "object",
  "required": [
    "paymentId",
    "orderId",
    "amountCents"
  ],
  "properties": {
    "paymentId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^pay_"
    },
    "orderId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^ord_[0-9A-Z]{26}$"
    },
    "amountCents": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}
